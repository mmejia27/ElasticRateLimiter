{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Single-node development cluster: this node bootstraps itself and elects itself leader.
  // publicEndPoint must match the applicationUrl in Properties/launchSettings.json.
  "raft": {
    "publicEndPoint": "http://localhost:8080",
    "coldStart": true
  }
}
