{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Environment-agnostic Raft tuning only. Per-node settings - publicEndPoint, coldStart and
  // stateDir - must come from the environment (Raft__PublicEndPoint, Raft__ColdStart,
  // Raft__StateDir), because each node needs a different address and every deployment needs a
  // different writable location. See the Dockerfile for the container defaults.
  "raft": {
    "lowerElectionTimeout": 150,
    "upperElectionTimeout": 300
  },

  // Both exporters are off by default. The console exporter writes a full metrics dump to stdout
  // on every collection interval, which buries the application's own logs, and the OTLP exporter
  // retries forever when no collector is listening. Set OtlpEndpoint (e.g. http://localhost:4317)
  // or Console=true to turn them on.
  "Telemetry": {
    "Console": false
  }
}
